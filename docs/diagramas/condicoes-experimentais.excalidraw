{"id":"cc4t","type":"text","x":1060,"y":462,"width":140,"height":25,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":84,"version":1,"versionNonce":84,"isDeleted":false,"boundElements":null,"updated":1761100000000,"link":null,"locked":false,"fontSize":20,"fontFamily":1,"text":"L1","textAlign":"center","verticalAlign":"middle","containerId":"cc4","originalText":"L1","lineHeight":1.25},{"id":"nt1","type":"text","x":140,"y":570,"width":1070,"height":50,"angle":0,"strokeColor":"#6741d9","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":91,"version":1,"versionNonce":91,"isDeleted":false,"boundElements":null,"updated":1761100000000,"link":null,"locked":false,"fontSize":16,"fontFamily":1,"text":"Registro sombra: em A e C o sistema calcula e registra a decis\u00e3o que o ADIA teria tomado, mantendo um teto sombra pr\u00f3prio,\nsem aplicar nada ao teto real nem \u00e0 interface do estudante.","textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"Registro sombra: em A e C o sistema calcula e registra a decis\u00e3o que o ADIA teria tomado, mantendo um teto sombra pr\u00f3prio,\nsem aplicar nada ao teto real nem \u00e0 interface do estudante.","lineHeight":1.25},{"id":"nt2","type":"text","x":140,"y":645,"width":1070,"height":50,"angle":0,"strokeColor":"#c92a2a","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":92,"version":1,"versionNonce":92,"isDeleted":false,"boundElements":null,"updated":1761100000000,"link":null,"locked":false,"fontSize":16,"fontFamily":1,"text":"Por que a Condi\u00e7\u00e3o C existe: sem ela, um resultado melhor em B poderia ser explicado apenas por receber menos ajuda.\nA Condi\u00e7\u00e3o C separa o efeito de adaptar do efeito de simplesmente reduzir.","textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"Por que a Condi\u00e7\u00e3o C existe: sem ela, um resultado melhor em B poderia ser explicado apenas por receber menos ajuda.\nA Condi\u00e7\u00e3o C separa o efeito de adaptar do efeito de simplesmente reduzir.","lineHeight":1.25},{"id":"nt3","type":"text","x":140,"y":720,"width":1070,"height":50,"angle":0,"strokeColor":"#5c5f66","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":93,"version":1,"versionNonce":93,"isDeleted":false,"boundElements":null,"updated":1761100000000,"link":null,"locked":false,"fontSize":16,"fontFamily":1,"text":"Atribui\u00e7\u00e3o por sorteio balanceado, com semente registrada. As tr\u00eas condi\u00e7\u00f5es registram as mesmas m\u00e9tricas.\nA exig\u00eancia de justificativa por excesso de confian\u00e7a vale somente na Condi\u00e7\u00e3o B.","textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"Atribui\u00e7\u00e3o por sorteio balanceado, com semente registrada. As tr\u00eas condi\u00e7\u00f5es registram as mesmas m\u00e9tricas.\nA exig\u00eancia de justificativa por excesso de confian\u00e7a vale somente na Condi\u00e7\u00e3o B.","lineHeight":1.25},{"id":"leg","type":"text","x":140,"y":800,"width":1070,"height":50,"angle":0,"strokeColor":"#5c5f66","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":94,"version":1,"versionNonce":94,"isDeleted":false,"boundElements":null,"updated":1761100000000,"link":null,"locked":false,"fontSize":16,"fontFamily":1,"text":"L1 metacognitivo   |   L2 conceitual   |   L3 procedural   |   L4 exemplo resolvido\nVerde: mais autonomia. Vermelho: mais ajuda dispon\u00edvel. Azul: depende do desempenho do estudante.","textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"L1 metacognitivo   |   L2 conceitual   |   L3 procedural   |   L4 exemplo resolvido\nVerde: mais autonomia. Vermelho: mais ajuda dispon\u00edvel. Azul: depende do desempenho do estudante.","lineHeight":1.25}],"appState":{"gridSize":null,"viewBackgroundColor":"#ffffff","theme":"dark","exportBackground":true,"exportWithDarkMode":true},"files":{}}